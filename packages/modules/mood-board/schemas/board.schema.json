{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heffrey78/gh-writer/schemas/v1/board.schema.json",
  "title": "A mood board (boards/<slug>.yaml)",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
    "cards": {
      "description": "In reading order, which is also front to back: a picture alone, a note, a note's picture or an entry.",
      "type": "array",
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "required": ["id", "title"],
  "additionalProperties": false,
  "$defs": {
    "card": {
      "type": "object",
      "properties": {
        "picture": {
          "description": "A picture in images/, by its repository path; on a note's card, `none` shows its words only.",
          "type": "string",
          "pattern": "^(none|images/(?!(.*/)?\\.\\.?(/|$))[^\\\\]*[^/\\\\])$"
        },
        "description": { "description": "A picture alone's description: a note's pictures have theirs in the note.", "type": "string" },
        "note": { "$ref": "common.schema.json#/$defs/id" },
        "entry": { "$ref": "common.schema.json#/$defs/id" },
        "at": { "description": "Its top left corner, in the board's own units: [x, y].", "$ref": "#/$defs/pair" },
        "size": { "description": "Its width and height, in the board's own units: [w, h].", "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 2, "maxItems": 2 }
      },
      "required": ["at", "size"],
      "additionalProperties": false
    },
    "pair": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
  }
}
