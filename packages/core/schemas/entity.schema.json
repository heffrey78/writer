{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heffrey78/gh-writer/schemas/v1/entity.schema.json",
  "title": "Bible entry front matter",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
    "aliases": { "$ref": "common.schema.json#/$defs/tags" },
    "summary": { "$ref": "common.schema.json#/$defs/text" },
    "image": { "$ref": "common.schema.json#/$defs/repoPath" },
    "image_focus": {
      "description": "Where thumbnails of the picture centre: x and y, as fractions of its width and height.",
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "minItems": 2,
      "maxItems": 2
    },
    "fields": {
      "description": "Its fields, by key: text, a number or yes/no; in a format 3 book, a list of IDs too (an entries field).",
      "type": "object",
      "additionalProperties": {
        "anyOf": [{ "type": ["string", "number", "boolean"] }, { "$ref": "common.schema.json#/$defs/idList" }]
      }
    },
    "changes": {
      "description": "Format 3: a field's new values from pieces on, each from the piece it names (inclusive); a null value takes the field off.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "value": {
            "anyOf": [{ "type": ["string", "number", "boolean", "null"] }, { "$ref": "common.schema.json#/$defs/idList" }]
          },
          "since": { "$ref": "common.schema.json#/$defs/id" }
        },
        "required": ["field", "value", "since"],
        "additionalProperties": false
      }
    },
    "tags": { "$ref": "common.schema.json#/$defs/tags" }
  },
  "required": ["id", "name"],
  "additionalProperties": false
}
