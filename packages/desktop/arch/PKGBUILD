# Writer for Arch Linux, from the .deb the desktop build makes, using the system's WebKitGTK.
# Build with `npm run desktop:arch` (which builds the .deb, then runs makepkg here), then install
# with `sudo pacman -U packages/desktop/arch/writer-*.pkg.tar.zst`.
pkgname=writer
pkgver=0.1.0
pkgrel=1
pkgdesc="Plan and write a novel with GitHub"
arch=('x86_64')
url="https://github.com/heffrey78/writer"
# Writer is MIT; the git inside it is GPL-2.0 (its licence and source offer are in
# /usr/lib/writer/runtime/licenses).
license=('MIT' 'GPL-2.0-only')
# The keychain needs libsecret (and a Secret Service, such as GNOME Keyring or KWallet); the git
# inside uses the system's libcurl for https; dictation hears the microphone through ALSA.
depends=('webkit2gtk-4.1' 'gtk3' 'libsecret' 'curl' 'alsa-lib')
# Node's and git's own binaries ship as their makers built them.
options=('!strip' '!debug')
source=("writer_${pkgver}_amd64.deb")
sha256sums=('SKIP')

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir"
}
